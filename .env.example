# Neon Postgres connection string
DATABASE_URL_2=

# Secret URL prefix of the admin panel (16-64 chars: a-z, 0-9, '-').
# The panel is served ONLY at https://<site>/<ADMIN_PATH>; /admin always returns 404.
# If unset or invalid, the admin panel is disabled.
# Generate one with: node -e "console.log('gestao-' + require('crypto').randomBytes(12).toString('hex'))"
ADMIN_PATH=

# Vercel Blob read/write token (Vercel project -> Storage -> Blob), used for noticia image uploads.
BLOB_READ_WRITE_TOKEN=
