generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_2")
}

model patrocinadores {
  id   Int     @id @default(autoincrement())
  nome String  @db.VarChar(100)
  logo String? @db.VarChar(255)
  url  String? @db.VarChar(255)
}

model modalidades {
  id            Int             @id @default(autoincrement())
  nome          String          @db.VarChar(100)
  slug          String          @unique @db.VarChar(100)
  icone         String?         @db.VarChar(255)
  descricao     String?
  ativo         Boolean         @default(true)
  categoria     String?         @db.VarChar(100)
  email         String?
  escalao       escalao[]
  preco_escalao preco_escalao[]
}

model escalao {
  id            Int         @id @default(autoincrement())
  modalidade_id Int
  nome          String      @db.VarChar(100)
  idade_minima  Int?
  idade_maxima  Int?
  descricao     String?
  mensalidade   Decimal?    @db.Decimal(10, 2)
  modalidades   modalidades @relation(fields: [modalidade_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model preco_escalao {
  id            Int         @id @default(autoincrement())
  modalidade_id Int
  escalao       String      @db.VarChar(100)
  tipo          String?     @db.VarChar(30)
  valor         Decimal?    @db.Decimal(10, 2)
  observacoes   String?
  modalidades   modalidades @relation(fields: [modalidade_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model noticias {
  id              Int      @id @default(autoincrement())
  titulo          String   @db.VarChar(200)
  conteudo        String?
  imagem          String?  @db.VarChar(255)
  data_publicacao DateTime @db.Date
  autor           String?  @db.VarChar(100)
  categoria       String?
  resumo          String?
  imagem_extra    String?  @db.VarChar(255)
}

model horarios {
  id             Int          @id @default(autoincrement())
  modalidade_id  Int
  local          String?
  inicio         DateTime
  fim            DateTime
  dia_da_semana  Int
  data_excecao   DateTime?
  modalidades    modalidades @relation(fields: [modalidade_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}
